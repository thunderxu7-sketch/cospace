{
  "name": "cospace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3027",
    "dev:api": "tsx watch server/index.ts",
    "build": "next build",
    "start": "node scripts/dev.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait db",
    "check": "npm run typecheck && npm test && npm run build",
    "test:ai": "node scripts/smoke-ai.mjs && node scripts/smoke-ai-actions.mjs",
    "format": "prettier --write src server tests scripts *.ts *.json",
    "format:check": "prettier --check src server tests scripts *.ts *.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@hocuspocus/provider": "4.8.0",
    "@hocuspocus/server": "4.8.0",
    "@hocuspocus/transformer": "4.8.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tiptap/extension-collaboration": "3.34.0",
    "@tiptap/extension-collaboration-caret": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@univerjs/preset-sheets-core": "1.5.2",
    "@univerjs/presets": "1.5.2",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.18.3",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.27",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "prettier": "^3.8.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "description": "A real-time AI collaboration workspace built with Next.js, Yjs and PostgreSQL."
}
