{
  "name": "cospace-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/run-native.mjs start --dev-client --localhost",
    "android": "node scripts/run-native.mjs run:android",
    "ios": "node scripts/run-native.mjs run:ios",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform android --platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "^7.1.33",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~55.0.32",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.41",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
