# Local defaults work without configuration. Copy to .env.local to override.
DATABASE_URL=postgres://cospace:cospace_local_only@127.0.0.1:55437/cospace
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
APP_ORIGIN=http://127.0.0.1:3027

# Pilot deployment (use a PostgreSQL database separate from the demo).
# COSPACE_MODE=pilot
# DATABASE_URL=postgres://...
